{
  "name": "angular-sat-router-lib",
  "version": "0.0.0",
  "scripts": {
    "start": "npm-run-all clear --parallel start:**",
    "start:sat-router": "ng build sat-router --watch",
    "start:app": "node ./scripts/waite-for-sat-router.js && ng serve",
    "clear": "node ./scripts/clear.js",
    "version": "cd ./projects/sat-router && npm version patch && cd ../../",
    "publish": "npm run version && ng build sat-router && cd dist/sat-router && npm pack && npm publish"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^14.1.3",
    "@angular/cdk": "^13.3.7",
    "@angular/common": "^14.1.3",
    "@angular/compiler": "^14.1.3",
    "@angular/core": "^14.1.3",
    "@angular/forms": "^14.1.3",
    "@angular/material": "^13.3.7",
    "@angular/platform-browser": "^14.1.3",
    "@angular/platform-browser-dynamic": "^14.1.3",
    "@angular/router": "^14.1.3",
    "@material/density": "^14.0.0",
    "highlight.js": "^11.5.1",
    "ngx-scrollbar": "^9.0.2",
    "rxjs": "~7.4.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.11.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^14.1.3",
    "@angular/cli": "^14.1.3",
    "@angular/compiler-cli": "^14.1.3",
    "@types/jasmine": "~3.10.0",
    "@types/node": "^12.11.1",
    "jasmine-core": "~3.10.0",
    "karma": "~6.3.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.1.0",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "~1.7.0",
    "ng-packagr": "^14.1.0",
    "typescript": "~4.7.4"
  }
}
